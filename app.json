{
  "expo": {
    "name": "霍克のAI助手",
    "slug": "hawk-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hawkai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.hawk.assistant",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.hawk.assistant"
        ]
      },
      "infoPlist": {
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSCalendarsWriteOnlyAccessUsageDescription": "Allow Hawk AI Assistant to add calendar events when you ask the assistant.",
        "NSHealthShareUsageDescription": "Allow Hawk AI Assistant to read selected health and fitness data when you ask the assistant.",
        "NSHealthUpdateUsageDescription": "Hawk AI Assistant reads selected Apple Health data to answer your health and fitness questions. It does not save or modify data in Apple Health.",
        "NSLocalNetworkUsageDescription": "Allow Hawk AI Assistant to connect to AI providers and MCP servers on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080B0C"
      },
      "package": "com.hawk.assistant",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/cherry-studio-splash-logo.png"
        }
      ],
      "./scripts/withAndroidBackgroundGeneration.js",
      "./scripts/withTabletOrientation.js",
      [
        "expo-widgets",
        {
          "enablePushNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a2e",
          "image": "./assets/icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080B0C"
          }
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hawk AI Assistant to take photos for chat messages and drawings.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Hawk AI Assistant to access calendars when you ask the assistant.",
          "remindersPermission": "Allow Hawk AI Assistant to access reminders when you ask the assistant."
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Hawk AI Assistant does not read or track your motion and fitness activity. This permission description is required by the location service included in the app.",
          "locationWhenInUsePermission": "Allow Hawk AI Assistant to use your location when you ask the assistant."
        }
      ],
      "expo-document-picker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GeistMono-Regular.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hawk AI Assistant to preview and select photos for drawings and chat messages.",
          "cameraPermission": "Allow Hawk AI Assistant to take photos for chat messages and drawings.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Hawk AI Assistant to preview photos for drawings and chat messages.",
          "savePhotosPermission": "Allow Hawk AI Assistant to save photos.",
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "17.0",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "sentryEnvironment": "production",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.hawk.assistant.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.hawk.assistant"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "25d2377d-bb12-4026-816b-08ab9857fb89"
      },
      "router": {}
    },
    "owner": "xhawk"
  }
}
